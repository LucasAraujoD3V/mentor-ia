# Desenvolvimento local: copie para .env. Nunca envie .env para o GitHub.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/mentor.sqlite
# Produção: NODE_ENV=production, APP_ORIGIN=https://seu-dominio, HTTPS no proxy.
# Produção exige envio real; não existe caixa de e-mails local em produção.
RESEND_API_KEY=
MAIL_FROM=
# Google é opcional. Callback autorizado: APP_ORIGIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
